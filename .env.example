# ==============================================================================
# PAY-PER-CALL AGENT ECONOMY (.env.example)
# DI-06 HACKATHON CONFIGURATION TEMPLATE
# DO NOT COMMIT ACTUAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL.
# Copy this file to .env and configure your values.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Blockchain & Network (Base Sepolia Testnet)
# Network CAIP-2 Identifier: eip155:84532
BLOCKCHAIN_NETWORK=eip155:84532
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# Token Configuration (Base Sepolia USDC)
# Base Sepolia USDC contract address
USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_DECIMALS=6

# x402 Facilitator Configuration
X402_FACILITATOR_URL=https://facilitator.x402.org
X402_CLIENT_TIMEOUT_SECONDS=15

# Buyer Wallet Configuration (Testnet only!)
# WARNING: Testnet wallet only. Never use mainnet keys or real funds.
BUYER_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
BUYER_PRIVATE_KEY=your_testnet_private_key_here
BUYER_MAX_BUDGET_USDC=1.000000
BUYER_DEFAULT_PER_REQUEST_MAX_USDC=0.050000

# Seller Pay-To Addresses (Registered recipients for x402 payments)
DATA_SELLER_PAY_TO=0x0000000000000000000000000000000000000001
SCRAPING_SELLER_PAY_TO=0x0000000000000000000000000000000000000002
INFERENCE_SELLER_PAY_TO=0x0000000000000000000000000000000000000003

# Seller Endpoint Configuration (Internal or Publicly Accessible)
DATA_SELLER_ENDPOINT=http://localhost:8000/api/v1/seller/data
SCRAPING_SELLER_ENDPOINT=http://localhost:8000/api/v1/seller/scraping
INFERENCE_SELLER_ENDPOINT=http://localhost:8000/api/v1/seller/inference

# Database Configuration (PostgreSQL / SQLite fallback for tests)
DATABASE_URL=sqlite:///./local_data/ledger.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agent_marketplace

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# ==============================================================================
# SELLER PROVIDER CONFIGURATION (MEMBER 2)
# ==============================================================================
# Provider Mode:
#   fake: Deterministic synthetic data (default, offline, zero API costs)
#   live: Outbound API calls to external services (requires provider API keys)
SELLER_PROVIDER_MODE=fake

# Inference Provider Selection (choose 'gemini' or 'groq')
INFERENCE_PROVIDER=gemini

# Google Gemini Configuration (required when INFERENCE_PROVIDER=gemini and SELLER_PROVIDER_MODE=live)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud Configuration (required when INFERENCE_PROVIDER=groq and SELLER_PROVIDER_MODE=live)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Inference Overrides
# INFERENCE_TIMEOUT_SECONDS=15.0
# INFERENCE_PROVIDER_URL=

# Optional Data Provider Upstream Configuration
# DATA_PROVIDER_URL=https://api.marketdata.example/price
# DATA_PROVIDER_API_KEY=your_data_provider_api_key_here
