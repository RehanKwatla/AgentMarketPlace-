# ==============================================================================
# PAY-PER-CALL AGENT ECONOMY (.env.example)
# DI-06 HACKATHON CONFIGURATION TEMPLATE
# DO NOT COMMIT ACTUAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL.
# Copy this file to .env and configure your values.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Blockchain & Network (Base Sepolia Testnet)
# Network CAIP-2 Identifier: eip155:84532
BLOCKCHAIN_NETWORK=eip155:84532
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# Token Configuration (Base Sepolia USDC)
# Base Sepolia USDC contract address
USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_DECIMALS=6

# x402 Facilitator Configuration
X402_FACILITATOR_URL=https://facilitator.x402.org
X402_CLIENT_TIMEOUT_SECONDS=15

# Buyer Wallet Configuration (Testnet only!)
# WARNING: Testnet wallet only. Never use mainnet keys or real funds.
BUYER_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
BUYER_PRIVATE_KEY=your_testnet_private_key_here
BUYER_MAX_BUDGET_USDC=1.000000
BUYER_DEFAULT_PER_REQUEST_MAX_USDC=0.050000

# Seller Pay-To Addresses (Registered recipients for x402 payments)
DATA_SELLER_PAY_TO=0x0000000000000000000000000000000000000001
SCRAPING_SELLER_PAY_TO=0x0000000000000000000000000000000000000002
INFERENCE_SELLER_PAY_TO=0x0000000000000000000000000000000000000003

# Seller Endpoint Configuration (Internal or Publicly Accessible)
DATA_SELLER_ENDPOINT=http://localhost:8000/api/v1/seller/data
SCRAPING_SELLER_ENDPOINT=http://localhost:8000/api/v1/seller/scraping
INFERENCE_SELLER_ENDPOINT=http://localhost:8000/api/v1/seller/inference

# Database Configuration
# In production (ENVIRONMENT=production), PostgreSQL is REQUIRED (e.g. Render Managed PostgreSQL).
# Render automatically injects postgres:// which the backend converts to postgresql://.
# For local development or offline test suite, SQLite fallback is supported.
DATABASE_URL=sqlite:///./local_data/ledger.db
# Example for PostgreSQL / Render:
# DATABASE_URL=postgresql://user:password@dpg-xxxx.render.com/agent_marketplace

# Frontend & CORS Configuration
# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed origins. Wildcards (*) are forbidden in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# For Vercel deployment, add your Vercel domains:
# CORS_ALLOWED_ORIGINS=https://agent-marketplace.vercel.app,http://localhost:5173

# Frontend Public Environment Variables (Vercel Build-time / Runtime)
# VITE_API_BASE_URL: URL of the deployed Render FastAPI backend.
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
# For Vercel production deployment pointing to Render:
# VITE_API_BASE_URL=https://agent-marketplace-api.onrender.com

# Optional LLM API Keys for Inference Seller (Leave unset for offline mock mode)
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
